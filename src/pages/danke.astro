---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Danke!" description="Deine Anmeldung wurde erfolgreich übermittelt.">
  <div class="min-h-[60vh] flex items-center justify-center">
    <div class="text-center max-w-md mx-auto px-4 py-16">
      <div class="text-6xl mb-6">🙏</div>
      <h1 class="text-3xl font-extrabold text-grey-dark mb-3">Herzlichen Dank!</h1>
      <p class="text-grey-mid leading-relaxed mb-8">
        Deine Anmeldung wurde erfolgreich übermittelt. Du erhältst in Kürze eine Bestätigung per E-Mail.
        Wir freuen uns auf deinen Einsatz!
      </p>
      <div class="flex flex-wrap gap-3 justify-center">
        <a href="/helfereinsaetze" class="btn-primary">Weitere Einsätze</a>
        <a href="/" class="btn-secondary">Zur Startseite</a>
      </div>
    </div>
  </div>
</Layout>
