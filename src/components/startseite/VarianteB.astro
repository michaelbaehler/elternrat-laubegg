---
// Variante B «Punkte»: verspielt, mit dem Punktekreis aus dem Logo, schräg gestellten Karten und viel Orange.
import { THEMEN } from '../../lib/themen';
import { startseitenDaten } from '../../lib/startseite';
import { datumMittel, tag, monat } from '../../lib/datum';
import { KONTAKT_EMAIL } from '../../site.config';

const { termine, einsaetze } = await startseitenDaten();
const neigung = ['-rotate-2', 'rotate-1', '-rotate-1', 'rotate-2', '-rotate-1'];
---

<section class="relative overflow-hidden bg-orange-lighter">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-16 sm:py-24 grid md:grid-cols-2 gap-10 items-center">
    <div>
      <p class="inline-block rounded-full bg-white px-3 py-1 text-sm font-semibold text-orange-dark shadow-sm">Hallo Eltern! 👋</p>
      <h1 class="mt-5 text-4xl sm:text-5xl lg:text-6xl font-extrabold leading-[1.05] text-grey-dark">
        Viele Eltern.<br/>Viele Ideen.<br/><span class="text-orange">Ein Elternrat.</span>
      </h1>
      <p class="mt-5 text-lg text-grey-mid max-w-lg">
        Wir verbinden die Eltern der Schule Laubegg – mit Schlittschuhen, Znüni, Läusekämmen und offenen Ohren für eure Anliegen.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/helfereinsaetze" class="btn-primary text-base">Ich helfe mit</a>
        <a href="/themen" class="btn-secondary text-base">Was wir machen</a>
      </div>
    </div>
    <div class="relative mx-auto w-72 sm:w-96 aspect-square" aria-hidden="true">
      <img src="/brand/erl.svg" alt="" class="absolute inset-0 w-full h-full animate-[spin_60s_linear_infinite]" />
      <img src="/images/fotos/schulfest-konfetti.jpg" alt="" class="absolute inset-[22%] w-[56%] h-[56%] rounded-full object-cover shadow-lg ring-8 ring-white" />
    </div>
  </div>
</section>

<section class="max-w-6xl mx-auto px-4 sm:px-6 py-16">
  <h2 class="text-3xl font-extrabold text-grey-dark text-center">Da packen wir an</h2>
  <p class="text-grey-mid text-center mt-2">Klick dich durch – überall freuen wir uns über Verstärkung.</p>
  <div class="mt-10 grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-5">
    {THEMEN.map((t, i) => (
      <a href={t.href} class:list={['group block rounded-2xl bg-white p-2 shadow-md ring-1 ring-grey-border transition-transform duration-200 hover:rotate-0 hover:scale-105', neigung[i]]}>
        <img src={t.img} alt="" class="rounded-xl w-full aspect-[20/11] object-cover" />
        <p class="px-2 pt-3 pb-2 font-bold text-grey-dark group-hover:text-orange-dark">{t.name}</p>
      </a>
    ))}
  </div>
</section>

<section class="bg-grey-dark text-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12 grid grid-cols-3 gap-4 text-center">
    {[
      { zahl: '4', text: 'Sitzungen pro Schuljahr' },
      { zahl: '5', text: 'Themengruppen' },
      { zahl: 'Fr. 20.–', text: 'für Schlittschuhe, die ganze Saison' },
    ].map(z => (
      <div>
        <p class="text-4xl sm:text-5xl font-extrabold text-orange">{z.zahl}</p>
        <p class="text-sm text-white/80 mt-1">{z.text}</p>
      </div>
    ))}
  </div>
</section>

<section class="max-w-6xl mx-auto px-4 sm:px-6 py-16 grid lg:grid-cols-5 gap-10">
  <div class="lg:col-span-3">
    <h2 class="text-2xl font-extrabold text-grey-dark mb-5">Bald los</h2>
    <ol class="space-y-3">
      {termine.slice(0, 5).map(t => (
        <li class="flex items-center gap-4 rounded-2xl bg-white p-3 pr-5 ring-1 ring-grey-border">
          <div class="flex-shrink-0 w-16 h-16 rounded-full bg-orange text-white flex flex-col items-center justify-center" aria-hidden="true">
            <span class="text-xl font-extrabold leading-none">{tag(t.date)}</span>
            <span class="text-[11px] font-semibold uppercase">{monat(t.date)}</span>
          </div>
          <div class="min-w-0">
            <p class="font-bold text-grey-dark leading-tight">{t.title}</p>
            <p class="text-sm text-grey-muted">{datumMittel(t.date)}{t.time ? ` · ${t.time}` : ''}</p>
          </div>
        </li>
      ))}
    </ol>
    <a href="/termine" class="inline-block mt-5 font-semibold text-orange-dark hover:text-orange-darker">Ganzer Kalender →</a>
  </div>
  <div class="lg:col-span-2">
    <div class="rounded-3xl bg-orange p-7 text-white rotate-1">
      <p class="text-sm font-semibold uppercase tracking-wider text-white/90">Helfende gesucht</p>
      {einsaetze.length > 0 ? (
        <ul class="mt-4 space-y-4">
          {einsaetze.slice(0, 3).map(e => (
            <li>
              <a href={`/helfereinsaetze/${e.slug}`} class="block rounded-xl bg-white/15 p-4 hover:bg-white/25 transition-colors">
                <p class="font-bold leading-tight">{e.data.title}</p>
                <p class="text-sm text-white/85 mt-1">{datumMittel(e.data.date)}</p>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="mt-4 text-white/90">Gerade ist alles besetzt – danke! Schau bald wieder vorbei.</p>
      )}
      <a href="/helfereinsaetze" class="mt-6 inline-flex rounded-lg bg-white px-4 py-2 font-semibold text-orange-dark hover:bg-orange-lighter">Alle Einsätze</a>
    </div>
  </div>
</section>

<section class="max-w-6xl mx-auto px-4 sm:px-6 pb-4">
  <div class="rounded-3xl bg-orange-lighter p-8 sm:p-10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
    <div>
      <h2 class="text-2xl font-extrabold text-grey-dark">Eine Idee? Ein Anliegen?</h2>
      <p class="text-grey-mid mt-1">Erzähl es uns – direkt oder über die Elternratsvertretung deiner Klasse.</p>
    </div>
    <a href={`mailto:${KONTAKT_EMAIL}`} class="btn-primary text-base whitespace-nowrap">Schreib uns</a>
  </div>
</section>
