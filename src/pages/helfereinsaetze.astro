---
import Layout from '../layouts/Layout.astro';
import HelferCard from '../components/HelferCard.astro';
import { getCollection } from 'astro:content';
import { heute } from '../lib/termine';
import { KONTAKT_EMAIL } from '../site.config';

const today = heute();
const alle = await getCollection('helfereinsaetze', e => e.data.active);
alle.sort((a, b) => a.data.date.localeCompare(b.data.date));
const offen = alle.filter(e => e.data.date >= today);
---

<Layout title="Helfereinsätze" description="Hilf beim Schlittschuhverleih, bei Raus Laus oder an einem Anlass mit – jede Stunde zählt.">

  <div class="bg-orange">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10">
      <span class="bg-white/20 text-white text-xs font-semibold px-2.5 py-0.5 rounded-full mb-3 inline-block">Mitmachen</span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white">Helfereinsätze</h1>
      <p class="text-white/90 mt-2 max-w-xl">
        Viele Hände, schnelles Ende: Ob eine Stunde beim Schlittschuhverleih oder ein Vormittag bei Raus Laus –
        jede Unterstützung hilft. Mitmachen können alle Eltern, nicht nur Mitglieder des Elternrats.
      </p>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12">

    <section class="mb-14">
      <h2 class="section-title">Hier brauchen wir dich</h2>
      <p class="section-subtitle">Wähle einen Einsatz und melde dich über das Formular an.</p>
      {offen.length > 0
        ? <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
            {offen.map(e => (
              <HelferCard
                title={e.data.title}
                date={e.data.date}
                time={e.data.time}
                location={e.data.location}
                description={e.data.description}
                spotsTotal={e.data.spotsTotal}
                spotsTaken={e.data.spotsTaken}
                deadline={e.data.deadline}
                slug={e.slug}
              />
            ))}
          </div>
        : <div class="card text-center text-grey-muted py-12">
            <p class="font-semibold text-grey-dark">Im Moment sind keine Einsätze ausgeschrieben.</p>
            <p class="text-sm mt-1">Bald suchen wir Helfende fürs Adventsznüni und die Schlittschuh-Rücknahme – schau wieder vorbei!</p>
          </div>
      }
    </section>

    <section class="mb-14 bg-grey-bg rounded-2xl p-8">
      <h2 class="text-xl font-bold text-grey-dark mb-6">So einfach geht's</h2>
      <div class="grid sm:grid-cols-3 gap-6">
        {[
          { step: '1', title: 'Einsatz aussuchen', desc: 'Schau, welcher Termin für dich passt.' },
          { step: '2', title: 'Formular ausfüllen', desc: 'Name, E-Mail, fertig – das dauert eine Minute.' },
          { step: '3', title: 'Vorbeikommen', desc: 'Vor dem Einsatz erhältst du alle Infos. Vorkenntnisse brauchst du keine.' },
        ].map(s => (
          <div class="flex gap-4">
            <div class="h-9 w-9 rounded-full bg-orange text-white font-bold flex items-center justify-center flex-shrink-0 text-sm">{s.step}</div>
            <div>
              <p class="font-semibold text-grey-dark">{s.title}</p>
              <p class="text-sm text-grey-muted mt-0.5">{s.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="card border-orange bg-orange-lighter">
      <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4 justify-between">
        <div>
          <p class="font-bold text-grey-dark">Fragen zu einem Einsatz?</p>
          <p class="text-sm text-grey-mid mt-0.5">Schreib uns – wir antworten gern.</p>
        </div>
        <a href={`mailto:${KONTAKT_EMAIL}`} class="btn-primary whitespace-nowrap">E-Mail schreiben</a>
      </div>
    </section>

  </div>

</Layout>
