---
import Layout from '../../layouts/Layout.astro';
import ThemaKopf from '../../components/ThemaKopf.astro';
import { KONTAKT_EMAIL } from '../../site.config';

const rueckblick = [
  {
    datum: '24. Februar 2026',
    titel: 'Elternworkshop «Digitales Gleichgewicht»',
    text: 'Workshop zum Umgang mit digitalen Medien in der Familie.',
    href: '/uploads/flyer-workshop-digitales-gleichgewicht-2026-02-24.pdf',
  },
  {
    datum: '4. November 2025',
    titel: 'Infoabend Jugendlohn',
    text: 'Wie Kinder lernen, mit eigenem Geld umzugehen – durchgeführt von Chindernetz Bern im Auftrag des Elternrats.',
    href: '/uploads/flyer-jugendlohn-2025-11-04.pdf',
  },
];
---

<Layout title="Elternbildung" description="Infoabende, Workshops und Austausch für Eltern der Schule Laubegg.">

  <ThemaKopf
    titel="Elternbildung"
    untertitel="Wissen teilen, Fragen stellen, voneinander lernen."
    img="/images/themen/elternbildung.svg"
  />

  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12">
    <div class="prose prose-sm max-w-none text-grey-mid mb-10">
      <p class="text-base text-grey-dark">
        Von Zeit zu Zeit organisieren wir einen Anlass für Eltern: einen Infoabend, ein Referat oder einen Workshop
        zu Themen, die Familien mit Schulkindern beschäftigen. Oft arbeiten wir dafür mit Fachstellen wie
        <a href="https://www.chindernetz.be/" target="_blank" rel="noopener">Chindernetz Bern</a> zusammen.
      </p>
    </div>

    <h2 class="text-xl font-bold text-grey-dark mb-4">Rückblick</h2>
    <div class="space-y-4">
      {rueckblick.map(r => (
        <div class="card flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <div>
            <p class="text-xs font-semibold uppercase tracking-wider text-orange-dark">{r.datum}</p>
            <p class="font-bold text-grey-dark mt-1">{r.titel}</p>
            <p class="text-sm text-grey-mid mt-1">{r.text}</p>
          </div>
          <a href={r.href} target="_blank" rel="noopener" class="btn-secondary text-sm py-1.5 px-3 whitespace-nowrap">Flyer (PDF)</a>
        </div>
      ))}
    </div>

    <div class="mt-10 card bg-orange-lighter border-orange/20 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <p class="font-semibold text-grey-dark">Welches Thema interessiert dich?</p>
        <p class="text-sm text-grey-mid mt-1">Medien, Lernen, Geld, Pubertät … Wir nehmen deine Wünsche für den nächsten Anlass gerne auf.</p>
      </div>
      <a href={`mailto:${KONTAKT_EMAIL}?subject=Elternbildung`} class="btn-primary text-sm whitespace-nowrap">Thema vorschlagen</a>
    </div>
  </div>

</Layout>
