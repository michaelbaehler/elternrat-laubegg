---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { datumKurz, tag, monat } from '../lib/datum';
import { heute } from '../lib/termine';

const today = heute();
const alle = await getCollection('sitzungen');
alle.sort((a, b) => b.data.date.localeCompare(a.data.date));

const proSchuljahr = new Map<string, typeof alle>();
for (const s of alle) proSchuljahr.set(s.data.schuljahr, [...(proSchuljahr.get(s.data.schuljahr) ?? []), s]);
// innerhalb eines Schuljahres chronologisch
for (const liste of proSchuljahr.values()) liste.sort((a, b) => a.data.date.localeCompare(b.data.date));

const linkLabel = (url: string) =>
  url.endsWith('.pdf') ? 'Protokoll (PDF)' : url.includes('docs.google.com') ? 'Protokoll (Google Doc)' : 'Protokoll';
---

<Layout title="Sitzungen" description="Die Elternratssitzungen der Schule Laubegg mit Protokollen und Präsentationen.">

  <div class="bg-orange-lighter border-b border-grey-border">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10">
      <span class="badge-orange mb-3 inline-block">Sitzungen und Protokolle</span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-grey-dark">Sitzungen</h1>
      <p class="text-grey-mid mt-2 max-w-2xl">
        Viermal im Schuljahr treffen sich die Elternratsvertreter:innen aller Klassen – jeweils am Montag um 19:30 Uhr in der Aula des Schulhauses Laubegg.
        Sie bringen Anliegen aus den Klassen ein, tauschen sich mit der Schulleitung aus und planen die Aktivitäten des Elternrats.
        Du möchtest auch dabei sein? Dann werde Elternratsvertreter:in deiner Klasse.
      </p>
    </div>
  </div>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12">

    <div class="card bg-orange-lighter border-orange/20 mb-10 flex items-start gap-4">
      <svg class="h-5 w-5 text-orange flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
      </svg>
      <p class="text-sm text-grey-mid">
        <span class="font-semibold text-grey-dark">Einige Protokolle sind mit einem Passwort geschützt</span> (🔒), weil sie Namen und Details aus den Klassen enthalten.
        Das Passwort steht jeweils in der E-Mail, mit der wir das Protokoll verschicken.
      </p>
    </div>

    {[...proSchuljahr].map(([schuljahr, sitzungen]) => (
      <section class="mb-10">
        <h2 class="text-lg font-bold text-grey-dark mb-4 pb-2 border-b border-grey-border">Schuljahr {schuljahr}</h2>
        <div class="flex flex-col gap-3">
          {sitzungen.map(s => {
            const kommend = s.data.date >= today;
            return (
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 p-4 rounded-xl border border-grey-border bg-white">
                <div class="flex items-center gap-4">
                  <div class:list={['flex-shrink-0 w-12 text-center rounded-lg py-2', kommend ? 'bg-orange text-white' : 'bg-orange-light']} aria-hidden="true">
                    <div class="text-xl font-bold leading-none">{tag(s.data.date)}</div>
                    <div class:list={['text-xs font-semibold uppercase', kommend ? 'text-white/90' : 'text-orange-dark']}>{monat(s.data.date)}</div>
                  </div>
                  <div>
                    <p class="font-semibold text-grey-dark">{s.data.title}</p>
                    <p class="text-sm text-grey-muted">{datumKurz(s.data.date)}{kommend && ' · 19:30 Uhr, Aula Schulhaus Laubegg'}</p>
                  </div>
                </div>
                <div class="flex flex-wrap gap-2 sm:justify-end">
                  {s.data.protokollUrl
                    ? <a href={s.data.protokollUrl} target="_blank" rel="noopener" class="btn-secondary text-sm py-1.5 px-3 whitespace-nowrap">
                        {linkLabel(s.data.protokollUrl)}{s.data.passwort && ' 🔒'}
                      </a>
                    : !kommend && <span class="text-sm text-grey-muted italic">Protokoll folgt</span>
                  }
                  {s.data.praesentationUrl && (
                    <a href={s.data.praesentationUrl} target="_blank" rel="noopener" class="btn-secondary text-sm py-1.5 px-3 whitespace-nowrap">
                      Präsentation (PDF)
                    </a>
                  )}
                </div>
              </div>
            );
          })}
        </div>
      </section>
    ))}

  </div>

</Layout>
