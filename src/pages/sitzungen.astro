---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const alle = await getCollection('sitzungen');
alle.sort((a, b) => b.data.date.localeCompare(a.data.date));

// Gruppieren nach Schuljahr
const bySchuljahr = alle.reduce<Record<string, typeof alle>>((acc, s) => {
  const sj = s.data.schuljahr;
  if (!acc[sj]) acc[sj] = [];
  acc[sj].push(s);
  return acc;
}, {});

function formatDate(d: string) {
  return new Date(d).toLocaleDateString('de-CH', {
    day: 'numeric', month: 'long', year: 'numeric'
  });
}
---

<Layout title="Sitzungen" description="Sitzungsprotokolle des Elternrats Laubegg — mit Passwortschutz ab Schuljahr 2023/2024.">

  <div class="bg-orange-lighter border-b border-grey-border">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10">
      <span class="badge-orange mb-3 inline-block">Protokolle</span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-grey-dark">Sitzungen</h1>
      <p class="text-grey-mid mt-2 max-w-xl">
        Der ERL trifft sich viermal jährlich — Montag, 19:30 Uhr, Aula Schulhaus Laubegg.
      </p>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12">

    <!-- Passwort-Hinweis -->
    <div class="card bg-orange-lighter border-orange/20 mb-10 flex items-start gap-4">
      <svg class="h-5 w-5 text-orange flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
      </svg>
      <div>
        <p class="font-semibold text-grey-dark text-sm">Protokolle mit Passwortschutz</p>
        <p class="text-sm text-grey-mid mt-0.5">
          Ab Schuljahr 2023/2024 sind die Protokolle aus Datenschutzgründen passwortgeschützt.
          Das Passwort erhältst du per E-Mail oder an einer Sitzung.
        </p>
      </div>
    </div>

    <!-- Sitzungen nach Schuljahr -->
    {Object.entries(bySchuljahr).map(([schuljahr, sitzungen]) => (
      <section class="mb-10">
        <h2 class="text-lg font-bold text-grey-dark mb-4 pb-2 border-b border-grey-border">
          Schuljahr {schuljahr}
        </h2>
        <div class="flex flex-col gap-3">
          {sitzungen.map(s => (
            <div class="card flex items-center justify-between gap-4">
              <div class="flex items-center gap-4">
                <div class="flex-shrink-0 w-12 text-center bg-orange-light rounded-lg py-2">
                  <div class="text-xl font-bold text-orange leading-none">
                    {new Date(s.data.date).getDate()}
                  </div>
                  <div class="text-xs font-semibold text-orange-dark uppercase">
                    {new Date(s.data.date).toLocaleDateString('de-CH', { month: 'short' })}
                  </div>
                </div>
                <div>
                  <p class="font-semibold text-grey-dark">{s.data.title}</p>
                  <p class="text-sm text-grey-muted">{formatDate(s.data.date)}</p>
                </div>
              </div>
              {s.data.protokollUrl
                ? <a
                    href={s.data.protokollUrl}
                    target="_blank"
                    rel="noopener"
                    class="btn-secondary text-sm py-1.5 px-3 whitespace-nowrap flex items-center gap-1.5"
                  >
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                    </svg>
                    Protokoll {s.data.passwort && '🔒'}
                  </a>
                : <span class="text-sm text-grey-muted italic">Protokoll folgt</span>
              }
            </div>
          ))}
        </div>
      </section>
    ))}
  </div>
</Layout>
