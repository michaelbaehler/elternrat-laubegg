---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { datumLang } from '../../lib/datum';
import { KONTAKT_EMAIL } from '../../site.config';

export async function getStaticPaths() {
  const einsaetze = await getCollection('helfereinsaetze');
  return einsaetze.map(einsatz => ({ params: { slug: einsatz.slug }, props: { einsatz } }));
}

const { einsatz } = Astro.props;
const { title, date, time, location, description, formUrl, spotsTotal, spotsTaken = 0, deadline, thema } = einsatz.data;
const { Content } = await einsatz.render();

const spotsLeft = spotsTotal !== undefined ? spotsTotal - spotsTaken : undefined;
const isFull = spotsLeft !== undefined && spotsLeft <= 0;

// Google Formulare lassen sich nur mit der langen Adresse einbetten (nicht mit forms.gle).
const embedUrl = formUrl && /docs\.google\.com\/forms\//.test(formUrl)
  ? formUrl.replace(/\/(viewform|edit)?(\?.*)?$/, '/viewform?embedded=true')
  : undefined;

const mailto = `mailto:${KONTAKT_EMAIL}?subject=${encodeURIComponent(`Helfereinsatz: ${title} (${datumLang(date)})`)}`;
---

<Layout title={title} description={description}>

  <div class="bg-grey-bg border-b border-grey-border">
    <nav class="max-w-6xl mx-auto px-4 sm:px-6 py-3 text-sm text-grey-muted flex items-center gap-2" aria-label="Brotkrümel">
      <a href="/" class="hover:text-orange-dark transition-colors">Startseite</a>
      <span aria-hidden="true">/</span>
      <a href="/helfereinsaetze" class="hover:text-orange-dark transition-colors">Helfereinsätze</a>
      <span aria-hidden="true">/</span>
      <span class="text-grey-dark font-medium truncate">{title}</span>
    </nav>
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
    <div class="grid lg:grid-cols-3 gap-12">

      <div class="lg:col-span-2">
        <div class="mb-3 flex gap-2 flex-wrap">
          {thema && <span class="badge-orange">{thema}</span>}
          {isFull && <span class="badge bg-grey-light text-grey-muted">Besetzt</span>}
          {!isFull && spotsLeft !== undefined && <span class="badge bg-green-100 text-green-800">Noch {spotsLeft} {spotsLeft === 1 ? 'Platz' : 'Plätze'} frei</span>}
        </div>
        <h1 class="text-3xl font-extrabold text-grey-dark mb-4">{title}</h1>

        <dl class="grid sm:grid-cols-2 gap-x-6 gap-y-3 text-sm mb-8 pb-6 border-b border-grey-border">
          <div>
            <dt class="text-grey-muted">Wann</dt>
            <dd class="font-semibold text-grey-dark">{datumLang(date)}{time ? `, ${time}` : ''}</dd>
          </div>
          <div>
            <dt class="text-grey-muted">Wo</dt>
            <dd class="font-semibold text-grey-dark">{location}</dd>
          </div>
          {deadline && (
            <div>
              <dt class="text-grey-muted">Anmelden bis</dt>
              <dd class="font-semibold text-grey-dark">{datumLang(deadline)}</dd>
            </div>
          )}
        </dl>

        <div class="prose prose-sm max-w-none text-grey-mid">
          <p class="text-base text-grey-dark">{description}</p>
          <Content />
        </div>

        {embedUrl && !isFull && (
          <section class="mt-10" id="anmeldung">
            <h2 class="text-xl font-bold text-grey-dark mb-4">Anmeldung</h2>
            <iframe
              src={embedUrl}
              title={`Anmeldeformular: ${title}`}
              class="w-full rounded-xl border border-grey-border bg-white"
              style="height: 900px;"
              loading="lazy"
            >Formular wird geladen …</iframe>
          </section>
        )}
      </div>

      <aside>
        <div class="card sticky top-24">
          {isFull ? (
            <div class="text-center py-4">
              <p class="font-bold text-grey-dark">Dieser Einsatz ist bereits besetzt</p>
              <p class="text-sm text-grey-muted mt-2">Herzlichen Dank an alle, die mithelfen! Vielleicht passt dir ein anderer Einsatz?</p>
              <a href="/helfereinsaetze" class="btn-secondary mt-4 text-sm">Weitere Einsätze</a>
            </div>
          ) : formUrl ? (
            <>
              <h2 class="font-bold text-lg text-grey-dark mb-1">Bist du dabei?</h2>
              <p class="text-sm text-grey-muted mb-5">Die Anmeldung dauert nur eine Minute.</p>
              <a href={embedUrl ? '#anmeldung' : formUrl} target={embedUrl ? undefined : '_blank'} rel="noopener" class="btn-primary w-full justify-center">
                Zur Anmeldung
              </a>
              {embedUrl && (
                <a href={formUrl} target="_blank" rel="noopener" class="block text-center text-xs text-grey-muted hover:text-orange-dark mt-3">
                  Formular in neuem Fenster öffnen
                </a>
              )}
            </>
          ) : (
            <>
              <h2 class="font-bold text-lg text-grey-dark mb-1">Anmeldung folgt</h2>
              <p class="text-sm text-grey-muted mb-5">Das Anmeldeformular ist bald hier. Du möchtest dir den Einsatz schon jetzt sichern? Schreib uns einfach.</p>
              <a href={mailto} class="btn-primary w-full justify-center">E-Mail schreiben</a>
            </>
          )}
        </div>
      </aside>

    </div>
  </div>

</Layout>
