---
import Layout from '../../layouts/Layout.astro';
import { THEMEN } from '../../lib/themen';
import { KONTAKT_EMAIL } from '../../site.config';
---

<Layout title="Themen" description="Die Themengruppen des Elternrats Laubegg – offen für alle Eltern.">

  <div class="bg-orange-lighter border-b border-grey-border">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10">
      <span class="badge-orange mb-3 inline-block">Themengruppen</span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-grey-dark">Was wir anpacken</h1>
      <p class="text-grey-mid mt-2 max-w-2xl">
        In unseren Themengruppen setzen wir Projekte für die ganze Schule um.
        Mitmachen kann jede und jeder – du musst dafür nicht im Elternrat sein.
      </p>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {THEMEN.map(t => (
        <a href={t.href} class="group rounded-2xl border border-grey-border overflow-hidden hover:border-orange hover:shadow-md transition-all duration-200 bg-white flex flex-col">
          <div class="overflow-hidden aspect-[20/11] bg-orange-lighter">
            <img src={t.img} alt="" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
          </div>
          <div class="p-5 flex flex-col flex-1">
            <div class="flex items-start justify-between gap-2 mb-2">
              <h2 class="font-bold text-lg text-grey-dark group-hover:text-orange-dark transition-colors leading-tight">{t.name}</h2>
              <span class="badge bg-grey-light text-grey-muted whitespace-nowrap flex-shrink-0 mt-0.5">{t.badge}</span>
            </div>
            <p class="text-sm text-grey-mid leading-relaxed flex-1">{t.kurz}</p>
            <span class="mt-4 flex items-center gap-1 text-sm font-semibold text-orange-dark">
              Mehr erfahren
              <svg class="h-4 w-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
              </svg>
            </span>
          </div>
        </a>
      ))}

      <div class="rounded-2xl border-2 border-dashed border-grey-border p-6 flex flex-col justify-center">
        <h2 class="font-bold text-lg text-grey-dark">Dir brennt etwas unter den Nägeln?</h2>
        <p class="text-sm text-grey-mid mt-2">
          Anliegen, Ideen oder ein Thema, das wir abklären sollen? Melde dich direkt bei uns oder über die Elternratsvertretung deiner Klasse.
        </p>
        <a href={`mailto:${KONTAKT_EMAIL}`} class="btn-primary mt-4 self-start text-sm">Schreib uns</a>
      </div>
    </div>
  </div>

</Layout>
