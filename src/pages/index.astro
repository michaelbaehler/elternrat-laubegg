---
import Layout from '../layouts/Layout.astro';
import HelferCard from '../components/HelferCard.astro';
import TerminCard from '../components/TerminCard.astro';
import { getCollection } from 'astro:content';

const now = new Date();
const today = now.toISOString().split('T')[0];

const alleHelfer = await getCollection('helfereinsaetze', e =>
  e.data.active && e.data.date >= today
);
alleHelfer.sort((a, b) => a.data.date.localeCompare(b.data.date));
const nextHelfer = alleHelfer.slice(0, 3);

const alleTermine = await getCollection('termine', e =>
  e.data.date >= today
);
alleTermine.sort((a, b) => a.data.date.localeCompare(b.data.date));
const nextTermine = alleTermine.slice(0, 4);
---

<Layout title="Startseite">

  <!-- Hero -->
  <section class="bg-gradient-to-br from-orange-lighter via-white to-grey-bg border-b border-grey-border">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-16 sm:py-20">
      <div class="max-w-2xl">
        <span class="badge-orange mb-4 inline-block">Schulkreis Kirchenfeld-Schosshalde</span>
        <h1 class="text-4xl sm:text-5xl font-extrabold text-grey-dark leading-tight mb-4">
          Elternrat<br/>
          <span class="text-orange">Laubegg</span>
        </h1>
        <p class="text-lg text-grey-mid leading-relaxed mb-8">
          Wir sind das Informations- und Austauschgremium der Eltern an der
          Schule Laubegg in Bern — offen für alle Eltern, keine Mitgliedschaft nötig.
        </p>
        <div class="flex flex-wrap gap-3">
          <a href="/helfereinsaetze" class="btn-primary">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
            </svg>
            Helfer werden
          </a>
          <a href="/ueber-uns" class="btn-secondary">
            Über den ERL
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Themengruppen Schnellübersicht -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
    <h2 class="section-title">Unsere Themengruppen</h2>
    <p class="section-subtitle">Alle Eltern sind herzlich willkommen mitzumachen.</p>

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3">
      {[
        { label: 'Schlittschuhverleih', href: '/themen/schlittschuhverleih', img: '/images/themen/schlittschuhverleih.svg' },
        { label: 'Events',              href: '/themen/events',              img: '/images/themen/events.svg' },
        { label: 'Elternbildung',       href: '/themen/elternbildung',       img: '/images/themen/elternbildung.svg' },
        { label: 'Raus Laus',           href: '/themen/raus-laus',           img: '/images/themen/raus-laus.svg' },
        { label: 'Sicherheit',          href: '/themen/sicherheit',          img: '/images/themen/sicherheit.svg' },
      ].map(t => (
        <a
          href={t.href}
          class="group flex flex-col rounded-xl border border-grey-border overflow-hidden hover:border-orange hover:shadow-sm transition-all duration-150 text-center bg-white"
        >
          <div class="h-24 overflow-hidden bg-orange-lighter">
            <img src={t.img} alt={t.label} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
          </div>
          <span class="text-xs font-semibold text-grey-dark px-2 py-2 leading-tight group-hover:text-orange transition-colors">{t.label}</span>
        </a>
      ))}
    </div>
  </section>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 pb-16 grid lg:grid-cols-2 gap-12">

    <!-- Nächste Helfereinsätze -->
    <section>
      <div class="flex items-center justify-between mb-6">
        <div>
          <h2 class="section-title mb-0">Helfereinsätze</h2>
          <p class="text-grey-muted text-sm">Wir freuen uns über deine Unterstützung!</p>
        </div>
        <a href="/helfereinsaetze" class="text-sm font-semibold text-orange hover:text-orange-dark transition-colors">
          Alle anzeigen →
        </a>
      </div>

      {nextHelfer.length > 0
        ? <div class="flex flex-col gap-4">
            {nextHelfer.map(e => (
              <HelferCard
                title={e.data.title}
                date={e.data.date}
                location={e.data.location}
                description={e.data.description}
                spotsTotal={e.data.spotsTotal}
                spotsTaken={e.data.spotsTaken}
                deadline={e.data.deadline}
                slug={e.slug}
              />
            ))}
          </div>
        : <div class="card text-center text-grey-muted py-8">
            <p class="text-3xl mb-2">🎉</p>
            <p>Aktuell sind keine Helfereinsätze ausgeschrieben.</p>
          </div>
      }
    </section>

    <!-- Nächste Termine -->
    <section>
      <div class="flex items-center justify-between mb-6">
        <div>
          <h2 class="section-title mb-0">Nächste Termine</h2>
          <p class="text-grey-muted text-sm">Alle Daten auf einen Blick</p>
        </div>
        <a href="/termine" class="text-sm font-semibold text-orange hover:text-orange-dark transition-colors">
          Alle anzeigen →
        </a>
      </div>

      {nextTermine.length > 0
        ? <div class="flex flex-col gap-3">
            {nextTermine.map(t => (
              <TerminCard
                title={t.data.title}
                date={t.data.date}
                time={t.data.time}
                location={t.data.location}
                category={t.data.category}
              />
            ))}
          </div>
        : <div class="card text-center text-grey-muted py-8">
            <p>Keine bevorstehenden Termine.</p>
          </div>
      }
    </section>
  </div>

  <!-- Kontakt-Banner -->
  <section class="bg-grey-dark text-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12 flex flex-col sm:flex-row items-center justify-between gap-6">
      <div>
        <h2 class="text-xl font-bold mb-1">Fragen oder Ideen?</h2>
        <p class="text-grey-muted text-sm">Schreib uns — alle Eltern sind willkommen.</p>
      </div>
      <a href="mailto:elternrat_laubegg@gmx.ch" class="btn-primary whitespace-nowrap">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
        </svg>
        E-Mail schreiben
      </a>
    </div>
  </section>

</Layout>
