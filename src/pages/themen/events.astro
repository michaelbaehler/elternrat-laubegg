---
import Layout from '../../layouts/Layout.astro';
import ThemaKopf from '../../components/ThemaKopf.astro';
import { KONTAKT_EMAIL } from '../../site.config';

const anlaesse = [
  {
    name: 'Frühlingstreffen',
    wann: 'jeweils im Frühling',
    text: 'Unser Dankeschön an die Lehrpersonen und alle Mitarbeitenden der Schule Laubegg: Wir Eltern bewirten sie – und es bleibt viel Zeit für ungezwungene Gespräche.',
  },
  {
    name: 'Adventsznüni',
    wann: 'in der Adventszeit',
    text: 'An jedem Standort ein feines Znüni für die Kinder. Eine schöne Tradition, die nur dank vielen Helfenden möglich ist.',
  },
  {
    name: 'Gangsingen',
    wann: 'im Schulhaus Laubegg',
    text: 'Ein wiederkehrender Anlass, bei dem im Schulhausgang gemeinsam gesungen wird.',
  },
  {
    name: 'Sommerfest',
    wann: 'abwechselnd im Sonnenhof und im Laubegg',
    text: 'Seit Corona hat leider keines mehr stattgefunden. Wir würden das Sommerfest gerne wiederbeleben – hast du Lust, mitzuplanen?',
  },
];
---

<Layout title="Events" description="Frühlingstreffen, Adventsznüni und weitere Anlässe des Elternrats Laubegg.">

  <ThemaKopf
    titel="Events"
    untertitel="Anlässe, die Eltern, Kinder und Schule zusammenbringen."
    img="/images/themen/events.webp"
  />

  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12">
    <div class="prose prose-sm max-w-none text-grey-mid mb-10">
      <p class="text-base text-grey-dark">
        Die Themengruppe Events organisiert und unterstützt Anlässe an der Schule Laubegg.
        Ein fester Wert im Kalender ist das Frühlingstreffen – daneben packen wir gerne bei weiteren Ideen mit an.
      </p>
    </div>

    <div class="grid sm:grid-cols-2 gap-5">
      {anlaesse.map(a => (
        <div class="card">
          <p class="text-xs font-semibold uppercase tracking-wider text-orange-dark">{a.wann}</p>
          <h2 class="font-bold text-lg text-grey-dark mt-1 mb-2">{a.name}</h2>
          <p class="text-sm text-grey-mid">{a.text}</p>
        </div>
      ))}
    </div>

    <div class="mt-10 card bg-orange-lighter border-orange/20 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <p class="font-semibold text-grey-dark">Lust auf Organisieren, Backen oder Anpacken?</p>
        <p class="text-sm text-grey-mid mt-1">Ob eine Idee für einen neuen Anlass oder Hilfe am Tag selbst – wir freuen uns über dich.</p>
      </div>
      <a href={`mailto:${KONTAKT_EMAIL}?subject=Events`} class="btn-primary text-sm whitespace-nowrap">Melde dich</a>
    </div>
  </div>

</Layout>
