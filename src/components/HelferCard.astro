---
// Kachel für einen Helfereinsatz. Die ganze Kachel führt direkt zum Google Formular (neuer Tab).
// Ohne Formular-Link bleibt eine Anfrage per E-Mail.
import { datumBereich } from '../lib/datum';
import { KONTAKT_EMAIL } from '../site.config';
import StandortBadges from './StandortBadges.astro';

interface Props {
  title: string;
  date: string;
  dateEnd?: string;
  datumText?: string;
  time?: string;
  standorte?: string[];
  location?: string;
  description: string;
  formUrl?: string;
  spotsTotal?: number;
  spotsTaken?: number;
  deadline?: string;
}
const { title, date, dateEnd, datumText, time, standorte = [], location, description, formUrl, spotsTotal, spotsTaken = 0, deadline } = Astro.props;

const wann = datumText ?? datumBereich(date, dateEnd);
const spotsLeft = spotsTotal !== undefined ? spotsTotal - spotsTaken : undefined;
const isFull = spotsLeft !== undefined && spotsLeft <= 0;

const mailto = `mailto:${KONTAKT_EMAIL}?subject=${encodeURIComponent(`Helfereinsatz: ${title} (${wann})`)}`;
const href = isFull ? undefined : (formUrl ?? mailto);
const extern = Boolean(formUrl) && !isFull;
const Tag = href ? 'a' : 'div';
---

<Tag
  href={href}
  target={extern ? '_blank' : undefined}
  rel={extern ? 'noopener' : undefined}
  class:list={['card flex flex-col gap-3 group', isFull && 'opacity-60 hover:shadow-none hover:border-grey-border']}
  data-filter-item
  data-standorte={standorte.join('|')}
>
  <div class="flex items-start justify-between gap-3">
    <h3 class="font-bold text-lg text-grey-dark leading-tight group-hover:text-orange-dark transition-colors">{title}</h3>
    {isFull
      ? <span class="badge bg-grey-light text-grey-muted whitespace-nowrap">Besetzt</span>
      : spotsLeft !== undefined && <span class="badge-orange whitespace-nowrap">Noch {spotsLeft} {spotsLeft === 1 ? 'Platz' : 'Plätze'}</span>
    }
  </div>

  <div class="flex flex-col gap-1 text-sm text-grey-muted">
    <span class="flex items-center gap-1.5">
      <svg class="h-4 w-4 text-orange flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
      </svg>
      {wann}{time ? ` · ${time}` : ''}
    </span>
    {(location || standorte.length > 0) && (
      <span class="flex items-start gap-1.5">
        <svg class="h-4 w-4 text-orange flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
        </svg>
        <span class="flex flex-col gap-1.5">
          {location && <span>{location}</span>}
          <StandortBadges standorte={standorte} />
        </span>
      </span>
    )}
    {deadline && <span class="pl-[1.375rem]">Anmelden bis {datumBereich(deadline)}</span>}
  </div>

  <p class="text-sm text-grey-mid leading-relaxed">{description}</p>

  <span class="mt-auto inline-flex items-center gap-1 text-sm font-semibold text-orange-dark">
    {isFull ? 'Besetzt – danke fürs Interesse!' : formUrl ? 'Zum Anmeldeformular' : 'Per E-Mail anmelden'}
    {!isFull && (
      <svg class="h-4 w-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
      </svg>
    )}
    {extern && <span class="sr-only">(öffnet in neuem Tab)</span>}
  </span>
</Tag>
